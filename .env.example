# Copy to .env and fill in what you need. Never commit .env (it is git- and docker-ignored).

# Phone alerts: the scanner (docker compose --profile alerts up -d) and the autopilot (always on)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# Autopilot (pretend-money accounts + trend guide; starts with docker compose up -d).
# Start cash and coins apply after: docker compose run --rm web python -m cryptopredict.autopilot --reset
# AUTOPILOT_START_CASH=1000
# AUTOPILOT_TRADE_PCT=10       # % of the starting money per copied model call
# AUTOPILOT_COINS=BTCUSDT,ETHUSDT,SOLUSDT
# AUTOPILOT_REPORT_HOUR=1      # daily report after this hour, UTC
# AUTOPILOT_TRADE_ALERTS=1     # a phone message for every pretend trade

# Signal engine options for the dashboard's /api/engine (build it first:
#   docker compose run --rm web python -m quant.build_engine)
# Coins on the engine card. Default: the 16 main coins. Unless the list contains all 16,
# the model specialists lose their cross-asset inputs ("features unavailable"); to add
# coins such as memes, list the 16 defaults plus the extras. The trend overlay is unaffected.
# ENGINE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,SOLUSDT,LINKUSDT,LTCUSDT,TRXUSDT,AVAXUSDT,DOTUSDT,ATOMUSDT,BCHUSDT,ETCUSDT,XLMUSDT,PEPEUSDT,SHIBUSDT
# ENGINE_BOOK=0            # skip the live order-book liquidity veto
# ENGINE_TTL=300           # seconds to cache engine results

# Host port for the dashboard, and where it listens. The default is this computer only;
# 0.0.0.0 exposes it to your network (it has no login).
# PORT=8000
# BIND_ADDR=0.0.0.0

# Extras that plain `docker compose up -d / build / down` should include
# (list only the ones you use)
# COMPOSE_PROFILES=alerts,recorder

# Linux only: build the image with your user id so files in data/ and models/ stay yours.
# Rootless Docker or Docker Desktop for Linux: use 0 and 0 (container root maps to you there).
# HOST_UID=1000
# HOST_GID=1000

# If Docker Hub rate-limits image pulls
# BASE_IMAGE=mirror.gcr.io/library/python:3.13-slim
